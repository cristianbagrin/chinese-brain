// The website and account service at https://chinese.cristianbagrin.com.
//   public/    the pages (served as they are)
//   worker.js  /api/*: accounts and word-list sync, one small SQLite database per account
// Pushing to main deploys it (Cloudflare Workers Builds); by hand: `npx wrangler deploy` here.
// Password-reset emails need one secret: `npx wrangler secret put RESEND_API_KEY` (resend.com, free).
{
  "name": "chinesebrain",
  "main": "worker.js",
  "compatibility_date": "2026-11-01",
  "assets": { "directory": "./public", "binding": "ASSETS", "not_found_handling": "404-page", "run_worker_first": ["/api/*"] },
  "durable_objects": {
    "bindings": [
      { "name": "ACCOUNT", "class_name": "Account" },
      { "name": "LIMITER", "class_name": "Limiter" }
    ]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Account", "Limiter"] }],
  "vars": {
    "SITE": "https://chinese.cristianbagrin.com",
    "MAIL_FROM": "Chinese Brain <noreply@cristianbagrin.com>",
    "SUPPORT": "chris@cristianbagrin.com"
  }
}
