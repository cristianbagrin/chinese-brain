// The website and the account service for all of Chris's apps: https://chinese.cristianbagrin.com and https://account.cristianbagrin.com.
//   public/    the pages (served as they are): /brain/* is the Chinese Brain extension, /account the login
//              shared by everything on this site
//   worker.js  /api/*: accounts and word-list sync, one small SQLite database per account; and the
//              pages themselves, with Chris's edits from /edit put in (EDIT_KEY secret, see worker.js)
// Pushing to main deploys it (Cloudflare Workers Builds); by hand: `npx wrangler deploy` here.
// Password-reset emails need one secret: `npx wrangler secret put RESEND_API_KEY` (resend.com, free).
// Editing the pages at /edit needs another: `npx wrangler secret put EDIT_KEY` (the password, as on cristianbagrin.com).
{
  "name": "chinesebrain",
  "main": "worker.js",
  "compatibility_date": "2026-11-01",
  "assets": { "directory": "./public", "binding": "ASSETS", "not_found_handling": "none", "run_worker_first": ["/api/*", "/mcp/*", "/plus", "/plus/taste", "/", "/brain", "/brain/guide", "/brain/whats-new", "/brain/privacy", "/brain/dashboard", "/account", "/reset", "/edit", "/edit/*", "/welcome", "/brain/welcome", "/privacy", "/dashboard", "/guide", "/whats-new", "/brain/firefox", "/brain/chrome"] },
  "durable_objects": {
    "bindings": [
      { "name": "ACCOUNT", "class_name": "Account" },
      { "name": "LIMITER", "class_name": "Limiter" },
      { "name": "DIRECTORY", "class_name": "Directory" },
      { "name": "COPY", "class_name": "Copy" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Account", "Limiter"] },
    { "tag": "v2", "new_sqlite_classes": ["Directory"] },
    { "tag": "v3", "new_sqlite_classes": ["Copy"] }
  ],
  // chinesebrain.cristianbagrin.com is a short address that forwards to /brain.
  "routes": [
    { "pattern": "chinese.cristianbagrin.com", "custom_domain": true },
    { "pattern": "chinesebrain.cristianbagrin.com", "custom_domain": true },
    { "pattern": "account.cristianbagrin.com", "custom_domain": true }
  ],
  "vars": {
    "SITE": "https://chinese.cristianbagrin.com",
    "ACCOUNT_SITE": "https://account.cristianbagrin.com",
    "MAIL_FROM": "Cristian Bagrin <noreply@cristianbagrin.com>",
    "SUPPORT": "chris@cristianbagrin.com"
  },
  // Chinese Brain Plus: its database (CBP; FLAGS holds the release switches, see worker.js) and its
  // files (images, audio). Tables: `npx wrangler d1 migrations apply cbp --remote`.
  "d1_databases": [
    { "binding": "CBP", "database_name": "cbp", "database_id": "45d4396a-c2d2-402e-8c0f-243fd2de4491", "migrations_dir": "migrations" },
    { "binding": "FLAGS", "database_name": "cbp", "database_id": "45d4396a-c2d2-402e-8c0f-243fd2de4491", "migrations_dir": "migrations" }
  ],
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "cbp-files" }],
  // hourly: the taste test (src/cbp/taste.ts). Secrets for it: GEMINI_KEY, POLLINATIONS_KEY.
  "triggers": { "crons": ["23 * * * *"] },
  "env": {
    // https://chinese-staging.cristianbagrin.com: the next version, open only to accounts with the
    // `staging` switch. Same accounts and switches as the live site (the Durable Objects and FLAGS are
    // production's); its own CBP database and files, so trying things never touches real data.
    // Deploy: `npx wrangler deploy --env staging`. Needs one secret: STAGING_KEY (any long random string).
    "staging": {
      "name": "chinesebrain-staging",
      "assets": { "directory": "./public", "binding": "ASSETS", "not_found_handling": "none", "run_worker_first": true },
      "durable_objects": {
        "bindings": [
          { "name": "ACCOUNT", "class_name": "Account", "script_name": "chinesebrain" },
          { "name": "LIMITER", "class_name": "Limiter", "script_name": "chinesebrain" },
          { "name": "DIRECTORY", "class_name": "Directory", "script_name": "chinesebrain" },
          { "name": "COPY", "class_name": "Copy", "script_name": "chinesebrain" }
        ]
      },
      "routes": [{ "pattern": "chinese-staging.cristianbagrin.com", "custom_domain": true }],
      "vars": {
        "SITE": "https://chinese-staging.cristianbagrin.com",
        "ACCOUNT_SITE": "https://chinese-staging.cristianbagrin.com",
        "MAIL_FROM": "Cristian Bagrin <noreply@cristianbagrin.com>",
        "SUPPORT": "chris@cristianbagrin.com",
        "STAGING": "1"
      },
      "d1_databases": [
        { "binding": "CBP", "database_name": "cbp-staging", "database_id": "4e6022bf-7adc-4a61-a2d8-39f4ba192824", "migrations_dir": "migrations" },
        { "binding": "FLAGS", "database_name": "cbp", "database_id": "45d4396a-c2d2-402e-8c0f-243fd2de4491", "migrations_dir": "migrations" }
      ],
      "r2_buckets": [{ "binding": "FILES", "bucket_name": "cbp-files-staging" }],
      "triggers": { "crons": [] }
    }
  }
}
