{
  "name": "chinese-brain",
  "version": "1.0.3",
  "private": true,
  "description": "Firefox extension for Taiwan Mandarin learners: YouTube dual subtitles + hover lookup on any page, one shared dictionary and word store.",
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "lint:ext": "web-ext lint --source-dir dist",
    "start": "web-ext run --source-dir dist --url https://www.youtube.com",
    "zip": "npm run build && web-ext build --source-dir dist --artifacts-dir release --overwrite-dest",
    "data": "python3 scripts/build_data.py"
  },
  "devDependencies": {
    "@types/firefox-webext-browser": "120.0.4",
    "@types/node": "^22.20.5",
    "esbuild": "0.24.0",
    "typescript": "5.6.3",
    "web-ext": "8.3.0"
  }
}
